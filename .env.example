# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get a key in Google AI Studio and set it as a server-side environment
# variable. Never commit a real key to this file or the repo.
GEMINI_API_KEY=your_key_here

# INTERNAL_API_SECRET: shared secret protecting POST /api/detect-food from
# anonymous quota burn. Set the SAME long random value in both places:
#   - server: INTERNAL_API_SECRET
#   - client build: VITE_INTERNAL_API_SECRET
# NOTE: this is a tripwire, not user authentication — anyone who reads the
# built JS bundle can see the client-side value. Generate with e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=your_secret_here
VITE_INTERNAL_API_SECRET=your_secret_here
