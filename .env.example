# SERVER ONLY: use secret manager / application default credentials. Never use a VITE_ key for secrets.
GEMINI_API_KEY=
GEMINI_MODEL=
ENABLE_CLOUD_SCANS=false
ENABLE_ACCOUNT_DELETION=false
# Provisional conservative beta limits, NOT subscriptions or unlimited usage.
SCAN_DAILY_LIMIT=5
SCAN_GLOBAL_DAILY_LIMIT=50
# Exact deployed web origin and https://localhost for configured Android builds.
ALLOWED_ORIGINS=
PORT=3000

# PUBLIC build configuration; no credentials. Keep blank until deployment is verified.
VITE_API_BASE_URL=
VITE_SUPPORT_EMAIL=kaffeallain@gmail.com
VITE_PUBLIC_APP_URL=
